# Database
DATABASE_ASTERISK_HOST=avr-asterisk-db
DATABASE_ASTERISK_NAME=asterisk
DATABASE_ASTERISK_USERNAME=asterisk
DATABASE_ASTERISK_PASSWORD=passw0rd
DATABASE_ROOT_PASSWORD=passw0rd

# Asterisk
# Country of the dial/busy/ring tones in indications.conf (e.g. es, fr, it)
ASTERISK_COUNTRY=us
# Default language of the prompts (sounds/<language>/), e.g. es; empty keeps en
ASTERISK_LANGUAGE=
